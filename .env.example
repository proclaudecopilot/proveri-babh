# Примерен env за local/staging (ARC-007). Без стойности на секрети. Копира се в wp-config.php като define(...)
# или се чете от хостинга. НИКОГА не се commit-ва попълнен файл.

WP_ENVIRONMENT_TYPE=local            # local | staging | production — тестовете отказват да работят при production
DB_NAME=babh6_local                  # отделна база за всяка среда
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1

# Плъгин
BABH6_SYNC_URL=https://bfsa.egov.bg/wps/portal/bfsa-web/registers/Registyr_na_hranitelnite_dobavki
BABH6_SYNC_ENABLED=0                 # local/staging: 0 — ръчно „Провери и обнови сега“; production: 1
BABH6_RAW_STORAGE_PATH=              # суров слой (DAT-001); празно = wp-content/uploads/babh6/raw
BABH6_ANTHROPIC_KEY=                 # AI проверка; празно = разделът е „В подготовка“
BABH6_SITE_PASSWORD=                 # временна обща парола (до IAM-001); празно = публичен сайт

# Поща — задължително sink извън production
BABH6_MAIL_SINK_HOST=127.0.0.1
BABH6_MAIL_SINK_PORT=1025

# Плащания (BIL-*): само sandbox ключове извън production
BABH6_BILLING_PROVIDER=              # напр. stripe (не е окончателно избран — master-spec раздел 10)
BABH6_BILLING_SECRET_KEY=
BABH6_BILLING_WEBHOOK_SECRET=
